# AI Fund Lab vNext Phase1-A
# Copy to .env locally. Never commit real credentials.

JQUANTS_API_KEY=
JQUANTS_BASE_URL=https://api.jquants.com
JQUANTS_RATE_LIMIT_PER_MINUTE=60
JQUANTS_TIMEOUT_SECONDS=30
AI_FUND_LAB_RAW_STORAGE_FORMAT=jsonl

AI_FUND_LAB_RUNTIME_DIR=.runtime
# Optional overrides. Defaults are resolved under AI_FUND_LAB_RUNTIME_DIR.
# AI_FUND_LAB_DATA_DIR=.runtime/data
# AI_FUND_LAB_LOG_DIR=.runtime/logs
# AI_FUND_LAB_CACHE_DIR=.runtime/cache
# AI_FUND_LAB_REPORT_DIR=.runtime/reports
# AI_FUND_LAB_TMP_DIR=.runtime/tmp

# Phase9 daily notifications.
# LINE uses Messaging API. Do not commit real tokens or destination IDs.
AIFUNDLAB_LINE_CHANNEL_ACCESS_TOKEN=
AIFUNDLAB_LINE_TO_ID=

# Optional Discord webhook for public blog report notification.
AIFUNDLAB_DISCORD_WEBHOOK_URL=

# Phase10 Tachibana demo read-only login/session foundation.
# Keep real auth IDs and key paths in your local .env only. Never commit them.
TACHIBANA_API_ENV=demo
TACHIBANA_API_BASE_URL=https://demo-kabuka.e-shiten.jp/e_api_v4r9
TACHIBANA_API_AUTH_ID=
TACHIBANA_API_AUTH_ID_FILE=
TACHIBANA_API_PRIVATE_KEY_FILE=
TACHIBANA_API_PRIVATE_KEY_FORMAT=der
TACHIBANA_API_SECOND_PASSWORD_FILE=
TACHIBANA_API_LOCAL_CONFIG_PATH=
TACHIBANA_API_TIMEOUT_SECONDS=30
TACHIBANA_API_RATE_LIMIT_PER_SECOND=5
TACHIBANA_API_READONLY_SMOKE_ENABLED=false
TACHIBANA_API_READONLY_ALLOW_PROD=false
TACHIBANA_API_SESSION_CACHE_ENABLED=false
TACHIBANA_API_QUOTE_SYMBOL_LIMIT=50
TACHIBANA_API_QUOTE_COLUMNS=pDPP,tDPP:T,pDOP,pDHP,pDLP,pDV,pPRP
