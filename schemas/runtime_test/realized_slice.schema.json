{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/runtime_test/realized_slice.schema.json",
  "title": "Runtime Test Realized Slice Observability",
  "type": "object",
  "required": ["schema_version", "run_id", "business_date", "authority", "generated_at", "source_artifacts", "temporal_safety", "realized_slices"],
  "properties": {
    "schema_version": { "const": "realized_slice_observability.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "business_date": { "type": "string", "minLength": 1 },
    "authority": { "type": "string" },
    "contract_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "source_artifacts": { "type": "object" },
    "temporal_safety": { "type": "object" },
    "cost_basis_method": { "const": "AVERAGE_COST_RUNTIME_OWNED_FILL_PROJECTION" },
    "lot_level_status": { "type": "string" },
    "realized_slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["realized_slice_id", "position_campaign_id", "symbol", "sell_execution_id", "sell_quantity", "sell_price", "cost_basis_method", "allocated_cost_basis", "gross_realized_pnl", "fees", "tax", "net_realized_pnl", "remaining_quantity", "remaining_average_cost", "source_decision_type", "source_decision_id"],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
