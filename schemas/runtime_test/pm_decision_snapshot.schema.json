{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/runtime_test/pm_decision_snapshot.schema.json",
  "title": "Runtime Test PM Decision Snapshot",
  "type": "object",
  "required": ["schema_version", "run_id", "business_date", "authority", "generated_at", "source_artifacts", "temporal_safety", "snapshot_policy", "decisions"],
  "properties": {
    "schema_version": { "const": "pm_decision_snapshot.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "business_date": { "type": "string", "minLength": 1 },
    "authority": { "type": "string" },
    "contract_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "source_artifacts": { "type": "object" },
    "temporal_safety": { "type": "object" },
    "snapshot_policy": { "const": "DECISION_TIME_ONLY_NO_POST_HOC_OUTCOMES" },
    "source_status": { "type": "string" },
    "decisions": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  },
  "additionalProperties": true
}
