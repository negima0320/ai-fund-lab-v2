{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/runtime_test/benchmark_snapshot.schema.json",
  "title": "Runtime Test Benchmark Snapshot",
  "type": "object",
  "required": ["schema_version", "run_id", "business_date", "authority", "generated_at", "source_artifacts", "temporal_safety", "status", "benchmark_id", "benchmark_name", "benchmark_source", "required_decision"],
  "properties": {
    "schema_version": { "const": "benchmark_snapshot_observability.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "business_date": { "type": "string", "minLength": 1 },
    "authority": { "type": "string" },
    "contract_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "source_artifacts": { "type": "object" },
    "temporal_safety": { "type": "object" },
    "status": { "enum": ["MISSING", "AVAILABLE"] },
    "benchmark_id": { "type": "string" },
    "benchmark_name": { "type": "string" },
    "benchmark_source": { "type": "string" },
    "required_decision": { "type": "string" }
  },
  "additionalProperties": true
}
