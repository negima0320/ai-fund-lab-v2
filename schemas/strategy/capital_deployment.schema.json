{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/strategy/capital_deployment.schema.json",
  "title": "Capital Deployment Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "producer_version",
    "business_date",
    "as_of",
    "feature_date",
    "artifact_lifecycle_status",
    "source_authority_status",
    "producer_result_status",
    "runtime_consumer_eligibility",
    "portfolio_capital_posture",
    "cash_reserve_posture",
    "exposure_posture",
    "capital_constraint_status",
    "members",
    "member_count",
    "position_count_policy_reference",
    "cash_policy_reference",
    "exposure_policy_reference",
    "sizing_policy_reference",
    "concrete_values_decided",
    "position_count_decided",
    "cash_ratio_decided",
    "exposure_decided",
    "position_sizing_decided",
    "allocation_decided",
    "quantity_decided",
    "lot_rounding_decided",
    "source_artifacts",
    "source_hashes",
    "temporal_safety",
    "production_consumer_connected",
    "runtime_switch_performed",
    "legacy_authority_active",
    "existing_capital_deployment_authority_active",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": { "const": "capital_deployment.v1" },
    "producer_version": { "type": "string", "minLength": 1 },
    "business_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "as_of": { "type": "string", "minLength": 1 },
    "feature_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "artifact_lifecycle_status": { "const": "DRAFT" },
    "source_authority_status": {
      "enum": ["VALID", "MISSING", "STALE", "HASH_MISMATCH", "AUTHORITY_CONFLICT"]
    },
    "producer_result_status": { "enum": ["PASS", "REVIEW_REQUIRED", "BLOCK"] },
    "runtime_consumer_eligibility": { "const": "NOT_ELIGIBLE" },
    "portfolio_capital_posture": {
      "enum": ["DEPLOY", "MAINTAIN", "CONSERVE", "WITHHOLD", "UNRESOLVED"]
    },
    "cash_reserve_posture": {
      "enum": ["AVAILABLE", "PRESERVE", "CONFLICT", "UNRESOLVED"]
    },
    "exposure_posture": {
      "enum": ["EXPAND", "MAINTAIN", "REDUCE", "CONFLICT", "UNRESOLVED"]
    },
    "capital_constraint_status": {
      "enum": [
        "CAPITAL_SUFFICIENT",
        "CAPITAL_CONSTRAINED",
        "CASH_RESERVE_CONFLICT",
        "EXPOSURE_CONFLICT",
        "ALLOCATION_UNRESOLVED",
        "SOURCE_UNAVAILABLE",
        "PENDING_RESERVATION_CONFLICT"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "security_code",
          "membership_reference",
          "allocation_posture",
          "allocation_priority",
          "capital_constraint_status",
          "portfolio_construction_reference",
          "position_management_reference",
          "confidence",
          "uncertainty",
          "reason_codes"
        ],
        "properties": {
          "security_code": { "type": "string", "minLength": 1 },
          "membership_reference": { "type": "string" },
          "allocation_posture": {
            "enum": ["PRIORITIZE", "NORMAL", "DEPRIORITIZE", "WITHHOLD", "UNRESOLVED"]
          },
          "allocation_priority": { "type": "integer", "minimum": 1 },
          "capital_constraint_status": {
            "enum": [
              "CAPITAL_SUFFICIENT",
              "CAPITAL_CONSTRAINED",
              "CASH_RESERVE_CONFLICT",
              "EXPOSURE_CONFLICT",
              "ALLOCATION_UNRESOLVED",
              "SOURCE_UNAVAILABLE",
              "PENDING_RESERVATION_CONFLICT"
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "uncertainty": { "type": "string", "minLength": 1 },
          "reason_codes": { "type": "array", "items": { "type": "string" } }
        },
        "not": {
          "anyOf": [
            { "required": ["target_weight"] },
            { "required": ["allocation_jpy"] },
            { "required": ["target_notional"] },
            { "required": ["delta_notional"] },
            { "required": ["share_quantity"] },
            { "required": ["quantity"] },
            { "required": ["quantity_candidate"] },
            { "required": ["broker_quantity"] },
            { "required": ["order_quantity"] },
            { "required": ["lot_size"] },
            { "required": ["lot_rounding_result"] },
            { "required": ["minimum_order_amount"] }
          ]
        }
      }
    },
    "member_count": { "type": "integer", "minimum": 0 },
    "position_count_policy_reference": { "type": "string" },
    "cash_policy_reference": { "type": "string" },
    "exposure_policy_reference": { "type": "string" },
    "sizing_policy_reference": { "type": "string" },
    "concrete_values_decided": { "const": false },
    "position_count_decided": { "const": false },
    "cash_ratio_decided": { "const": false },
    "exposure_decided": { "const": false },
    "position_sizing_decided": { "const": false },
    "allocation_decided": { "const": false },
    "quantity_decided": { "const": false },
    "lot_rounding_decided": { "const": false },
    "source_artifacts": { "type": "array", "minItems": 1 },
    "source_hashes": { "type": "array", "minItems": 1 },
    "temporal_safety": {
      "type": "object",
      "required": [
        "point_in_time",
        "future_leakage_used",
        "feature_date_lte_business_date",
        "implicit_latest_fallback_used",
        "previous_day_capital_deployment_copied"
      ],
      "properties": {
        "point_in_time": { "type": "boolean" },
        "future_leakage_used": { "type": "boolean" },
        "feature_date_lte_business_date": { "type": "boolean" },
        "implicit_latest_fallback_used": { "const": false },
        "previous_day_capital_deployment_copied": { "const": false }
      }
    },
    "production_consumer_connected": { "const": false },
    "runtime_switch_performed": { "const": false },
    "legacy_authority_active": { "const": true },
    "existing_capital_deployment_authority_active": { "const": true },
    "artifact_hash": { "type": "string", "minLength": 32 }
  },
  "not": {
    "anyOf": [
      { "required": ["target_position_count"] },
      { "required": ["target_positions"] },
      { "required": ["target_cash_ratio"] },
      { "required": ["cash_ratio"] },
      { "required": ["target_exposure_ratio"] },
      { "required": ["target_weight"] },
      { "required": ["target_weight_pct"] },
      { "required": ["weight_percentage"] },
      { "required": ["allocation_jpy"] },
      { "required": ["target_notional"] },
      { "required": ["delta_notional"] },
      { "required": ["share_quantity"] },
      { "required": ["quantity"] },
      { "required": ["quantity_candidate"] },
      { "required": ["broker_quantity"] },
      { "required": ["order_quantity"] },
      { "required": ["lot_size"] },
      { "required": ["lot_rounding_result"] },
      { "required": ["minimum_order_amount"] }
    ]
  }
}
