{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy Decision Trace v1",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "strategy_decision_trace.v1"},
    "producer_version": {"type": "string"},
    "business_date": {"type": "string", "format": "date"},
    "profile": {"type": "string"},
    "run_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "overall_status": {"enum": ["PASS", "REVIEW_REQUIRED", "INCOMPLETE_ATTRIBUTION", "BLOCK"]},
    "artifact_lifecycle_status": {"const": "DRAFT"},
    "runtime_consumer_eligibility": {"const": "NOT_ELIGIBLE"},
    "artifact_inventory": {"type": "object"},
    "dependency_graph": {"type": "array"},
    "per_symbol_attribution": {"type": "array"},
    "portfolio_attribution": {"type": "object"},
    "source_artifacts": {"type": "array"},
    "source_hashes": {"type": "array"},
    "config_hashes": {"type": "array"},
    "status_propagation": {"type": "array"},
    "decision_path": {"type": "array"},
    "blocking_reasons": {"type": "array"},
    "review_reasons": {"type": "array"},
    "reason_code_aggregation": {"type": "object"},
    "legacy_dynamic_comparison": {"type": "object"},
    "readiness_summary": {"type": "array"},
    "outcome_boundary": {
      "type": "object",
      "properties": {
        "strategy_input_allowed": {"const": false},
        "learning_input_allowed": {"const": false}
      },
      "required": ["strategy_input_allowed", "learning_input_allowed"]
    },
    "runtime_behavior_changed": {"const": false},
    "runtime_switch_performed": {"const": false},
    "artifact_hash": {"type": "string"}
  },
  "required": [
    "schema_version",
    "producer_version",
    "business_date",
    "profile",
    "run_id",
    "trace_id",
    "overall_status",
    "artifact_lifecycle_status",
    "runtime_consumer_eligibility",
    "artifact_inventory",
    "dependency_graph",
    "per_symbol_attribution",
    "portfolio_attribution",
    "source_artifacts",
    "source_hashes",
    "config_hashes",
    "status_propagation",
    "decision_path",
    "blocking_reasons",
    "review_reasons",
    "reason_code_aggregation",
    "legacy_dynamic_comparison",
    "readiness_summary",
    "outcome_boundary",
    "runtime_behavior_changed",
    "runtime_switch_performed"
  ]
}
