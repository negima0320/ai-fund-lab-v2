{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/strategy/runtime_planning.schema.json",
  "title": "Runtime Planning Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "producer_version",
    "business_date",
    "as_of",
    "feature_date",
    "artifact_lifecycle_status",
    "source_authority_status",
    "producer_result_status",
    "runtime_consumer_eligibility",
    "plans",
    "plan_count",
    "concrete_allocation_decided",
    "concrete_quantity_decided",
    "lot_rounding_decided",
    "pending_written",
    "submit_generated",
    "source_artifacts",
    "source_hashes",
    "temporal_safety",
    "production_consumer_connected",
    "pending_writer_connected",
    "runtime_switch_performed",
    "legacy_authority_active",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": { "const": "runtime_planning.v1" },
    "producer_version": { "type": "string", "minLength": 1 },
    "business_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "as_of": { "type": "string", "minLength": 1 },
    "feature_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "artifact_lifecycle_status": { "const": "DRAFT" },
    "source_authority_status": {
      "enum": ["VALID", "MISSING", "STALE", "HASH_MISMATCH", "AUTHORITY_CONFLICT"]
    },
    "producer_result_status": { "enum": ["PASS", "REVIEW_REQUIRED", "BLOCK"] },
    "runtime_consumer_eligibility": { "const": "NOT_ELIGIBLE" },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "planning_id",
          "security_code",
          "planning_intent",
          "order_side_intent",
          "quantity_required",
          "quantity_authority",
          "quantity_status",
          "pending_eligibility",
          "pending_candidate_contract",
          "reason_codes"
        ],
        "properties": {
          "planning_id": { "type": "string", "minLength": 1 },
          "security_code": { "type": "string", "minLength": 1 },
          "planning_intent": {
            "enum": ["BUY_NEW", "BUY_ADD", "SELL_REDUCE", "SELL_EXIT", "NO_ACTION", "UNRESOLVED"]
          },
          "order_side_intent": { "enum": ["BUY", "SELL", "NONE", "UNRESOLVED"] },
          "quantity_required": { "type": "boolean" },
          "quantity_authority": { "type": "string" },
          "quantity_status": { "enum": ["UNRESOLVED", "NOT_REQUIRED"] },
          "pending_eligibility": {
            "enum": ["CANDIDATE_ONLY", "NOT_REQUIRED", "REVIEW_REQUIRED", "BLOCKED"]
          },
          "pending_candidate_contract": {
            "type": "object",
            "required": [
              "pending_candidate_generated",
              "pending_writer_connected",
              "submit_allowed",
              "broker_write_allowed"
            ],
            "properties": {
              "pending_candidate_generated": { "const": false },
              "pending_writer_connected": { "const": false },
              "submit_allowed": { "const": false },
              "broker_write_allowed": { "const": false }
            }
          },
          "reason_codes": { "type": "array", "items": { "type": "string" } }
        },
        "not": {
          "anyOf": [
            { "required": ["allocation_jpy"] },
            { "required": ["share_quantity"] },
            { "required": ["quantity"] },
            { "required": ["broker_quantity"] },
            { "required": ["order_quantity"] },
            { "required": ["lot_size"] },
            { "required": ["lot_rounding_result"] },
            { "required": ["order_price"] },
            { "required": ["pending_id"] },
            { "required": ["pending_item"] },
            { "required": ["submit_command"] },
            { "required": ["broker_request"] }
          ]
        }
      }
    },
    "plan_count": { "type": "integer", "minimum": 0 },
    "concrete_allocation_decided": { "const": false },
    "concrete_quantity_decided": { "const": false },
    "lot_rounding_decided": { "const": false },
    "pending_written": { "const": false },
    "submit_generated": { "const": false },
    "source_artifacts": { "type": "array", "minItems": 1 },
    "source_hashes": { "type": "array", "minItems": 1 },
    "temporal_safety": {
      "type": "object",
      "required": [
        "point_in_time",
        "future_leakage_used",
        "feature_date_lte_business_date",
        "implicit_latest_fallback_used",
        "previous_day_runtime_planning_copied"
      ],
      "properties": {
        "point_in_time": { "type": "boolean" },
        "future_leakage_used": { "type": "boolean" },
        "feature_date_lte_business_date": { "type": "boolean" },
        "implicit_latest_fallback_used": { "const": false },
        "previous_day_runtime_planning_copied": { "const": false }
      }
    },
    "production_consumer_connected": { "const": false },
    "pending_writer_connected": { "const": false },
    "runtime_switch_performed": { "const": false },
    "legacy_authority_active": { "const": true },
    "artifact_hash": { "type": "string", "minLength": 32 }
  },
  "not": {
    "anyOf": [
      { "required": ["allocation_jpy"] },
      { "required": ["target_notional"] },
      { "required": ["delta_notional"] },
      { "required": ["share_quantity"] },
      { "required": ["quantity"] },
      { "required": ["broker_quantity"] },
      { "required": ["order_quantity"] },
      { "required": ["lot_size"] },
      { "required": ["lot_rounding_result"] },
      { "required": ["minimum_order_amount"] },
      { "required": ["order_price"] },
      { "required": ["pending_id"] },
      { "required": ["pending_item"] },
      { "required": ["submit_command"] },
      { "required": ["broker_request"] }
    ]
  }
}
