{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/strategy/portfolio_policy.schema.json",
  "title": "Portfolio Policy Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "producer_version",
    "business_date",
    "as_of",
    "feature_date",
    "artifact_lifecycle_status",
    "source_authority_status",
    "producer_result_status",
    "runtime_consumer_eligibility",
    "risk_posture",
    "entry_posture",
    "position_count_posture",
    "cash_posture",
    "exposure_posture",
    "position_management_bias",
    "confidence",
    "uncertainty",
    "reason_codes",
    "deferred_concrete_values",
    "concrete_values_decided",
    "upstream_artifacts",
    "source_artifacts",
    "source_hashes",
    "temporal_safety",
    "production_consumer_connected",
    "runtime_switch_performed",
    "legacy_authority_active",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": { "const": "portfolio_policy.v1" },
    "producer_version": { "type": "string", "minLength": 1 },
    "business_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "as_of": { "type": "string", "minLength": 1 },
    "feature_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "artifact_lifecycle_status": { "const": "DRAFT" },
    "source_authority_status": {
      "enum": ["VALID", "MISSING", "STALE", "HASH_MISMATCH", "AUTHORITY_CONFLICT"]
    },
    "producer_result_status": { "enum": ["PASS", "REVIEW_REQUIRED", "BLOCK"] },
    "runtime_consumer_eligibility": { "const": "NOT_ELIGIBLE" },
    "risk_posture": { "enum": ["RISK_ON", "BALANCED", "DEFENSIVE", "RISK_OFF", "UNRESOLVED"] },
    "entry_posture": { "enum": ["EXPAND", "MAINTAIN", "RESTRICT", "PAUSE", "UNRESOLVED"] },
    "position_count_posture": { "enum": ["INCREASE", "MAINTAIN", "DECREASE", "UNRESOLVED"] },
    "cash_posture": { "enum": ["DEPLOY", "MAINTAIN", "RAISE", "UNRESOLVED"] },
    "exposure_posture": { "enum": ["INCREASE", "MAINTAIN", "REDUCE", "UNRESOLVED"] },
    "position_management_bias": { "enum": ["ADD_BIASED", "NEUTRAL", "REDUCE_BIASED", "EXIT_BIASED", "UNRESOLVED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty": { "type": "string", "minLength": 1 },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "deferred_concrete_values": { "type": "array", "items": { "type": "string" } },
    "concrete_values_decided": { "const": false },
    "upstream_artifacts": { "type": "object" },
    "source_artifacts": { "type": "array", "minItems": 1 },
    "source_hashes": { "type": "array", "minItems": 1 },
    "temporal_safety": {
      "type": "object",
      "required": [
        "point_in_time",
        "future_leakage_used",
        "feature_date_lte_business_date",
        "implicit_latest_fallback_used",
        "previous_day_policy_copied"
      ],
      "properties": {
        "point_in_time": { "type": "boolean" },
        "future_leakage_used": { "type": "boolean" },
        "feature_date_lte_business_date": { "type": "boolean" },
        "implicit_latest_fallback_used": { "const": false },
        "previous_day_policy_copied": { "const": false }
      }
    },
    "production_consumer_connected": { "const": false },
    "runtime_switch_performed": { "const": false },
    "legacy_authority_active": { "const": true },
    "artifact_hash": { "type": "string", "minLength": 32 }
  },
  "not": {
    "anyOf": [
      { "required": ["target_position_count"] },
      { "required": ["minimum_positions"] },
      { "required": ["target_positions"] },
      { "required": ["maximum_positions"] },
      { "required": ["target_cash_ratio"] },
      { "required": ["cash_ratio"] },
      { "required": ["target_exposure_ratio"] },
      { "required": ["gross_exposure"] },
      { "required": ["position_size"] },
      { "required": ["minimum_holding"] },
      { "required": ["cooldown"] }
    ]
  }
}
