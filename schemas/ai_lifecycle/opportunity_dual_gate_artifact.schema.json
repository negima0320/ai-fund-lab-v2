{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab-v2.local/schemas/ai_lifecycle/opportunity_dual_gate_artifact.schema.json",
  "title": "opportunity_dual_gate_artifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"type": "string"},
    "artifact_type": {"const": "OPPORTUNITY_DUAL_GATE_ARTIFACT"},
    "artifact_version": {"type": "string"},
    "artifact_status": {"enum": ["DUAL_GATE_OUTPUT", "DUAL_GATE_PASS", "DUAL_GATE_FAIL", "DUAL_GATE_REVIEW_REQUIRED"]},
    "created_at": {"type": "string"},
    "producer": {"type": "string"},
    "source_phase": {"const": "PHASE19_AH"},
    "schema_version": {"type": "string"},
    "authority": {"type": "string"},
    "global_gate_result": {"type": "object"},
    "selection_gate_result": {"type": "object"},
    "dual_gate_result": {"type": "object"},
    "bindings": {"type": "object"},
    "generation_eligibility": {"type": "boolean"},
    "runtime_eligibility": {"const": false},
    "accepted": {"const": false},
    "hash_inventory": {"type": "object"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "required": [
    "artifact_id",
    "artifact_type",
    "artifact_version",
    "artifact_status",
    "created_at",
    "producer",
    "source_phase",
    "schema_version",
    "authority",
    "global_gate_result",
    "selection_gate_result",
    "dual_gate_result",
    "bindings",
    "generation_eligibility",
    "runtime_eligibility",
    "accepted",
    "hash_inventory",
    "content_hash"
  ]
}
