    "commands": {
      "ai-status": {
        "broker_access": "NOT_PERFORMED",
        "evidence_root": "reports/runtime_tests/ai_status/<run_id>/",
        "normal_operator_entrypoint": false,
        "options": [
          "--detailed",
          "--json",
          "--write-evidence",
          "--check-runtime-readiness"
        ],
        "responsibility": "read-only AI Artifact Inspection",
        "state_change": false
      },
      "backup": {
        "responsibility": "backup resettable Trading State",
        "state_change": true
      },
      "close": {
        "responsibility": "freeze final evidence and judgments",
        "state_change": false
      },
      "plan": {
        "responsibility": "execution plan, dates, job sequence, evidence paths, commands",
        "state_change": false
      },
      "reset": {
        "responsibility": "all-or-nothing initial Trading State setup",
        "state_change": true
      },
      "resume": {
        "responsibility": "continue from last valid checkpoint without skipping failed jobs",
        "state_change": true
      },
      "rollback": {
        "responsibility": "restore full resettable Trading State bundle",
        "state_change": true
      },
      "run": {
        "responsibility": "invoke normal Runtime v2 CLI by business date and job",
        "state_change": true
      },
      "status": {
        "responsibility": "read-only Runtime Test state summary",
        "state_change": false
      },
      "system-status": {
        "broker_access": "NOT_PERFORMED",
        "evidence_root": "reports/runtime_tests/system_status/<run_id>/",
        "normal_operator_entrypoint": true,
        "options": [
          "--json",
          "--write-evidence"
        ],
        "responsibility": "daily read-only whole-system health inspection",
        "state_change": false
      },
      "validate": {
        "responsibility": "validate state, temporal, authority, and evidence consistency",
        "state_change": false
      }
    },
    "entrypoint": "PYTHONPATH=src python3 scripts/runtime_test.py <subcommand> [options]",
    "exit_codes": {
      "0": "PASS",
      "10": "REVIEW_REQUIRED",
      "20": "BLOCKED",
      "30": "HALT",
      "40": "VALIDATION_FAILURE",
      "50": "ROLLBACK_FAILURE",
      "60": "INVALID_ARGUMENT",
      "70": "PRECONDITION_FAILURE",
      "80": "TEST_INVALID",
      "90": "INTERNAL_ERROR"
    },
    "failure_flow": [
      "classify_failure",
      "resume_if_baselines_match",
      "rollback_if_state_validity_or_lifecycle_safety_is_uncertain",
      "validate",
      "evidence_freeze"
    ],
    "mutating_commands_require": [
      "--confirm",
      "--yes-i-understand-this-mutates-trading-state"
