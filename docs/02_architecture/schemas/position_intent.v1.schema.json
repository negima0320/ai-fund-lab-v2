{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/position_intent.v1.schema.json",
  "title": "Phase27-D2-A Shadow Canonical Position Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "authority_mode",
    "decision_effect",
    "producer_version",
    "run_id",
    "business_date",
    "accepted_generation",
    "artifact_status",
    "review_status",
    "reason_codes",
    "scope_contract",
    "input_artifact_refs",
    "summary",
    "intents"
  ],
  "properties": {
    "schema_version": { "const": "position_intent.v1" },
    "artifact_type": { "const": "position_intent" },
    "authority_mode": { "const": "SHADOW" },
    "decision_effect": { "const": "NONE" },
    "producer_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "business_date": { "type": "string", "format": "date" },
    "accepted_generation": { "type": ["string", "null"] },
    "artifact_status": { "type": "string", "enum": ["PASS", "REVIEW_REQUIRED", "BLOCK"] },
    "review_status": { "type": "string", "enum": ["PASS", "REVIEW_REQUIRED", "BLOCK"] },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "scope_contract": { "type": "object" },
    "input_artifact_refs": { "type": "object" },
    "summary": { "type": "object" },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "schema_version",
          "artifact_type",
          "authority_mode",
          "decision_effect",
          "run_id",
          "business_date",
          "accepted_generation",
          "symbol",
          "current_position_state",
          "pm_intent",
          "momentum_authority_mode",
          "incremental_eligibility_authority_mode",
          "proposed_position_intent",
          "intent_reason_codes",
          "input_artifact_refs",
          "lineage",
          "evidence_status",
          "missing_required_inputs",
          "review_status"
        ],
        "properties": {
          "schema_version": { "const": "position_intent.v1" },
          "artifact_type": { "const": "position_intent_row" },
          "authority_mode": { "const": "SHADOW" },
          "decision_effect": { "const": "NONE" },
          "run_id": { "type": "string", "minLength": 1 },
          "business_date": { "type": "string", "format": "date" },
          "accepted_generation": { "type": ["string", "null"] },
          "symbol": { "type": "string", "minLength": 1 },
          "position_campaign_id": { "type": ["string", "null"] },
          "current_position_state": { "type": "string" },
          "current_quantity": { "type": ["number", "null"] },
          "current_notional": { "type": ["number", "null"] },
          "current_weight": { "type": ["number", "null"] },
          "candidate_id": { "type": ["string", "null"] },
          "opportunity_id": { "type": ["string", "null"] },
          "opportunity_rank": { "type": ["integer", "number", "null"] },
          "opportunity_score": { "type": ["number", "null"] },
          "quality_decision_id": { "type": ["string", "null"] },
          "quality_score": { "type": ["number", "null"] },
          "quality_action": { "type": ["string", "null"] },
          "pm_decision_id": { "type": ["string", "null"] },
          "pm_intent": { "type": ["string", "null"] },
          "momentum_continuation_state": { "type": "string" },
          "momentum_authority_mode": { "const": "SHADOW" },
          "incremental_investment_eligibility": { "type": "string" },
          "incremental_eligibility_authority_mode": { "const": "SHADOW" },
          "proposed_position_intent": {
            "type": "string",
            "enum": ["BUY_NEW", "ADD", "HOLD", "REDUCE", "EXIT", "NO_ACTION", "UNRESOLVED"]
          },
          "intent_reason_codes": { "type": "array", "items": { "type": "string" } },
          "intent_summary": { "type": "string" },
          "input_artifact_refs": { "type": "object" },
          "lineage": { "type": "object" },
          "evidence_status": { "type": "string", "enum": ["PASS", "REVIEW_REQUIRED", "BLOCK"] },
          "missing_required_inputs": { "type": "array", "items": { "type": "string" } },
          "review_status": { "type": "string", "enum": ["PASS", "REVIEW_REQUIRED", "BLOCK"] }
        }
      }
    }
  }
}
