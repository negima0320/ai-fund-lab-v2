{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/02_architecture/schemas/legacy_pm_add_compatibility.v1.schema.json",
  "title": "Legacy PM ADD Compatibility Artifact v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "migration_state",
    "authority_mode",
    "decision_effect",
    "business_date",
    "quantity_authority",
    "pending_authority",
    "approval_authority",
    "submit_authority",
    "telemetry_only",
    "compatibility",
    "double_authority_guard",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "legacy_pm_add_compatibility.v1" },
    "artifact_type": { "const": "legacy_pm_add_compatibility" },
    "migration_state": { "const": "NON_DECISION_COMPATIBILITY" },
    "authority_mode": { "const": "COMPATIBILITY_TELEMETRY_ONLY" },
    "decision_effect": { "const": "NONE" },
    "business_date": { "type": "string" },
    "target_session_date": { "type": "string" },
    "environment": { "type": "string" },
    "run_id": { "type": "string" },
    "accepted_generation": { "type": "string" },
    "quantity_authority": { "const": "NONE" },
    "pending_authority": { "const": "NONE" },
    "approval_authority": { "const": "NONE" },
    "submit_authority": { "const": "NONE" },
    "telemetry_only": { "const": true },
    "compatibility_count": { "type": "integer", "minimum": 0 },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "artifact_type",
          "migration_state",
          "authority_mode",
          "decision_effect",
          "run_id",
          "business_date",
          "symbol",
          "position_campaign_id",
          "decision_id",
          "source_pm_intent",
          "legacy_path_would_have_been_invoked",
          "quantity_authority",
          "pending_authority",
          "approval_authority",
          "submit_authority",
          "telemetry_only",
          "dedup_key",
          "review_status"
        ],
        "properties": {
          "schema_version": { "const": "legacy_pm_add_compatibility.v1" },
          "artifact_type": { "const": "legacy_pm_add_compatibility_row" },
          "migration_state": { "const": "NON_DECISION_COMPATIBILITY" },
          "authority_mode": { "const": "COMPATIBILITY_TELEMETRY_ONLY" },
          "decision_effect": { "const": "NONE" },
          "run_id": { "type": "string" },
          "business_date": { "type": "string" },
          "target_session_date": { "type": "string" },
          "environment": { "type": "string" },
          "accepted_generation": { "type": "string" },
          "symbol": { "type": "string" },
          "position_campaign_id": { "type": "string" },
          "decision_id": { "type": "string" },
          "source_pm_decision_id": { "type": "string" },
          "source_pm_intent": { "const": "ADD" },
          "canonical_position_intent_ref": { "type": "string" },
          "canonical_target_portfolio_decision_ref": { "type": "string" },
          "compatibility_status": { "type": "string" },
          "compatibility_reason_codes": { "type": "array", "items": { "type": "string" } },
          "legacy_path_would_have_been_invoked": { "const": true },
          "quantity_authority": { "const": "NONE" },
          "pending_authority": { "const": "NONE" },
          "approval_authority": { "const": "NONE" },
          "submit_authority": { "const": "NONE" },
          "telemetry_only": { "const": true },
          "lineage": { "type": "object" },
          "dedup_key": { "type": "string" },
          "review_status": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "double_authority_guard": { "type": "object" },
    "review_status": { "enum": ["PASS", "REVIEW_REQUIRED"] }
  },
  "additionalProperties": true
}
