{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/artifact_acceptance_report.schema.json",
  "title": "Artifact Acceptance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_report_id",
    "artifact_or_set_ref",
    "reviewed_artifact_hashes",
    "reviewed_schema_hashes",
    "reviewed_source_refs",
    "human_reviewer",
    "architecture_reviewer",
    "regression_reviewer",
    "release_approver",
    "review_started_at",
    "review_completed_at",
    "decision",
    "acceptance_criteria_results",
    "regression_results",
    "known_limitations",
    "risk_classification",
    "rollback_target",
    "replacement_target",
    "git_commit",
    "runtime_version",
    "feature_schema_version",
    "canonical_data_manifest_ref",
    "model_freeze_manifest_ref",
    "approval_signatures",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "artifact_acceptance_report.v1" },
    "acceptance_report_id": { "type": "string", "minLength": 1 },
    "artifact_or_set_ref": { "type": "string", "minLength": 1 },
    "artifact_set_id": { "type": ["string", "null"] },
    "artifact_set_type": {
      "type": ["string", "null"],
      "enum": [
        "CANDIDATE_AI_SET",
        "OPPORTUNITY_AI_SET",
        "POSITION_MANAGEMENT_POLICY_SET",
        "CAPITAL_ALLOCATION_POLICY_SET",
        "FEATURE_SCHEMA_SET",
        "SAFETY_POLICY_SET",
        "CANDIDATE_ACCEPTED_SET",
        "OPPORTUNITY_ACCEPTED_SET",
        "PM_ACCEPTED_SET",
        null
      ]
    },
    "artifact_set_manifest_ref": { "type": ["string", "null"] },
    "artifact_set_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64}|[0-9a-f]{64})$" },
    "reviewed_artifact_hashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "reviewed_member_hashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "reviewed_schema_hashes": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "reviewed_source_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_bundle_ref": { "type": ["string", "null"] },
    "human_reviewer": { "type": "string" },
    "architecture_reviewer": { "type": "string" },
    "regression_reviewer": { "type": "string" },
    "release_approver": { "type": "string" },
    "review_started_at": { "type": "string", "format": "date-time" },
    "review_completed_at": { "type": "string", "format": "date-time" },
    "decision": { "type": "string", "enum": ["ACCEPT", "REJECT", "REVIEW_REQUIRED"] },
    "acceptance_criteria_results": { "type": "object", "additionalProperties": { "type": "string" } },
    "regression_results": { "type": "array", "items": { "type": "string" } },
    "regression_result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT", null] },
    "consumer_compatibility_result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT", null] },
    "point_in_time_result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT", "NOT_APPLICABLE", null] },
    "known_limitations": { "type": "array", "items": { "type": "string" } },
    "risk_classification": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "HALT"] },
    "rollback_target": { "type": ["string", "null"] },
    "rollback_target_ref": { "type": ["string", "null"] },
    "replacement_target": { "type": ["string", "null"] },
    "git_commit": { "type": ["string", "null"] },
    "runtime_version": { "type": ["string", "null"] },
    "feature_schema_version": { "type": ["string", "null"] },
    "canonical_data_manifest_ref": { "type": ["string", "null"] },
    "model_freeze_manifest_ref": { "type": ["string", "null"] },
    "approval_signatures": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": ["string", "null"] }
  }
}
