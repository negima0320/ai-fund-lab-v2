{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/artifact_set_manifest.schema.json",
  "title": "Artifact Set Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_set_id",
    "artifact_set_type",
    "artifact_set_version",
    "component",
    "member_artifacts",
    "required_member_types",
    "member_hashes",
    "schema_hashes",
    "compatibility_constraints",
    "training_period",
    "feature_schema_ref",
    "validation_evidence_refs",
    "runtime_consumer_refs",
    "artifact_set_hash",
    "status",
    "runtime_use_eligible"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "artifact_set_manifest.v1" },
    "artifact_set_id": { "type": "string", "minLength": 1 },
    "artifact_set_type": {
      "type": "string",
      "enum": [
        "CANDIDATE_AI_SET",
        "OPPORTUNITY_AI_SET",
        "POSITION_MANAGEMENT_POLICY_SET",
        "CAPITAL_ALLOCATION_POLICY_SET",
        "FEATURE_SCHEMA_SET",
        "SAFETY_POLICY_SET",
        "CANDIDATE_ACCEPTED_SET",
        "OPPORTUNITY_ACCEPTED_SET",
        "PM_ACCEPTED_SET"
      ]
    },
    "artifact_set_version": { "type": "string" },
    "set_authority_scope": { "type": ["string", "null"], "enum": ["SET_LEVEL", null] },
    "component": { "type": "string" },
    "member_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_artifact_id", "artifact_instance_id", "artifact_type", "content_hash", "schema_hash", "role"],
        "properties": {
          "logical_artifact_id": { "type": "string" },
          "artifact_instance_id": { "type": "string" },
          "artifact_set_id": { "type": ["string", "null"] },
          "artifact_type": { "type": "string" },
          "physical_path": { "type": ["string", "null"] },
          "content_hash": { "type": ["string", "null"] },
          "schema_hash": { "type": ["string", "null"] },
          "role": { "type": "string" },
          "member_role": {
            "type": ["string", "null"],
            "enum": [
              "MODEL",
              "MODEL_MANIFEST",
              "FEATURE_SCHEMA",
              "TRAINING_METADATA",
              "TRAINING_DATA_LINEAGE",
              "VALIDATION_EVIDENCE",
              "METRICS_EVIDENCE",
              "METRICS",
              "CONSUMER_COMPATIBILITY",
              "CODE_POLICY",
              "RUNTIME_ADAPTER",
              "POLICY_VERSION",
              "FEATURE_VERSION",
              "BEHAVIOR_CONTRACT",
              "REGRESSION_EVIDENCE",
              "POLICY",
              "POLICY_SCHEMA",
              "POINT_IN_TIME_EVIDENCE",
              "SCHEMA_VALIDATION_EVIDENCE",
              null
            ]
          },
          "status": {
            "type": ["string", "null"],
            "enum": ["DRAFT", "VALIDATED", "REVIEW_REQUIRED", "ACCEPTED", "LEGACY", "REVOKED", "REJECTED", null]
          },
          "accepted_status": {
            "type": ["string", "null"],
            "enum": ["DRAFT", "VALIDATED", "REVIEW_REQUIRED", "ACCEPTED", "LEGACY", "REVOKED", "REJECTED", "LEGACY_ONLY", "TRAINING_ONLY", null]
          },
          "migration_status": { "type": ["string", "null"] },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "runtime_use_eligible": { "type": ["boolean", "null"] }
        }
      }
    },
    "required_member_types": { "type": "array", "items": { "type": "string" } },
    "required_member_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MODEL",
          "MODEL_MANIFEST",
          "FEATURE_SCHEMA",
          "TRAINING_METADATA",
          "TRAINING_DATA_LINEAGE",
          "VALIDATION_EVIDENCE",
          "METRICS_EVIDENCE",
          "METRICS",
          "CONSUMER_COMPATIBILITY",
          "CODE_POLICY",
          "RUNTIME_ADAPTER",
          "POLICY_VERSION",
          "FEATURE_VERSION",
          "BEHAVIOR_CONTRACT",
          "REGRESSION_EVIDENCE",
          "POLICY",
          "POLICY_SCHEMA",
          "POINT_IN_TIME_EVIDENCE",
          "SCHEMA_VALIDATION_EVIDENCE"
        ]
      }
    },
    "member_hashes": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "schema_hashes": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "compatibility_constraints": { "type": "array", "items": { "type": "string" } },
    "training_period": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      }
    },
    "feature_schema_ref": { "type": ["string", "null"] },
    "consumer_compatibility_ref": { "type": ["string", "null"] },
    "source_lineage_ref": { "type": ["string", "null"] },
    "freeze_manifest_ref": { "type": ["string", "null"] },
    "validation_evidence_refs": { "type": "array", "items": { "type": "string" } },
    "regression_evidence_refs": { "type": "array", "items": { "type": "string" } },
    "runtime_consumer_refs": { "type": "array", "items": { "type": "string" } },
    "artifact_set_hash": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "REVIEW_REQUIRED", "ACCEPTED", "LEGACY", "REVOKED", "REJECTED"]
    },
    "runtime_use_eligible": { "type": "boolean" }
  }
}
