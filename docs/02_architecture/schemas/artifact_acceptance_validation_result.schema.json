{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/artifact_acceptance_validation_result.schema.json",
  "title": "Artifact Acceptance Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "validated_at",
    "artifact_set_id",
    "artifact_set_type",
    "set_validation_result",
    "member_validation_results",
    "role_validation_result",
    "regression_validation_result",
    "compatibility_validation_result",
    "point_in_time_validation_result",
    "eligibility_result",
    "overall_result",
    "failure_class",
    "errors",
    "warnings"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "artifact_acceptance_validation_result.v1" },
    "validation_id": { "type": "string", "minLength": 1 },
    "validated_at": { "type": "string", "format": "date-time" },
    "artifact_set_id": { "type": "string", "minLength": 1 },
    "artifact_set_type": {
      "type": "string",
      "enum": [
        "CANDIDATE_AI_SET",
        "OPPORTUNITY_AI_SET",
        "POSITION_MANAGEMENT_POLICY_SET",
        "CAPITAL_ALLOCATION_POLICY_SET",
        "FEATURE_SCHEMA_SET",
        "SAFETY_POLICY_SET"
      ]
    },
    "set_validation_result": { "type": "string", "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT"] },
    "member_validation_results": { "type": "object", "additionalProperties": { "type": "string" } },
    "role_validation_result": { "type": "string", "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT"] },
    "regression_validation_result": { "type": "string", "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT"] },
    "compatibility_validation_result": { "type": "string", "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT"] },
    "point_in_time_validation_result": { "type": "string", "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT", "NOT_APPLICABLE"] },
    "eligibility_result": { "type": "string", "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT"] },
    "overall_result": { "type": "string", "enum": ["PASS", "REVIEW_REQUIRED", "FAIL"] },
    "failure_class": { "type": "string", "enum": ["NONE", "VALIDATION_ERROR", "REVIEW_REQUIRED", "HALT"] },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
