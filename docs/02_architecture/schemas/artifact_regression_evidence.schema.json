{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fund-lab.local/schemas/artifact_regression_evidence.schema.json",
  "title": "Artifact Regression Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "regression_evidence_id",
    "artifact_or_set_ref",
    "profile",
    "test_scope",
    "test_command",
    "test_environment",
    "before_refs",
    "after_refs",
    "semantic_comparison",
    "hash_comparison",
    "schema_comparison",
    "candidate_decision_parity",
    "opportunity_decision_parity",
    "pm_decision_parity",
    "capital_allocation_parity",
    "planning_parity",
    "pending_parity",
    "submit_guard_parity",
    "current_unchanged",
    "ledger_unchanged",
    "pending_unchanged",
    "runtime_state_unchanged",
    "result",
    "failures",
    "timestamp_only_differences",
    "reviewer"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "artifact_regression_evidence.v1" },
    "regression_evidence_id": { "type": "string" },
    "artifact_or_set_ref": { "type": "string" },
    "artifact_set_id": { "type": ["string", "null"] },
    "artifact_set_type": {
      "type": ["string", "null"],
      "enum": [
        "CANDIDATE_AI_SET",
        "OPPORTUNITY_AI_SET",
        "POSITION_MANAGEMENT_POLICY_SET",
        "CAPITAL_ALLOCATION_POLICY_SET",
        "FEATURE_SCHEMA_SET",
        "SAFETY_POLICY_SET",
        "CANDIDATE_ACCEPTED_SET",
        "OPPORTUNITY_ACCEPTED_SET",
        "PM_ACCEPTED_SET",
        null
      ]
    },
    "profile": {
      "type": "string",
      "enum": ["CANDIDATE", "OPPORTUNITY", "PM", "CAPITAL_ALLOCATION", "FEATURE", "DATA", "REGISTRY_PATH_ONLY"]
    },
    "test_scope": { "type": "string" },
    "test_command": { "type": ["string", "null"] },
    "test_environment": { "type": "string" },
    "before_refs": { "type": "array", "items": { "type": "string" } },
    "after_refs": { "type": "array", "items": { "type": "string" } },
    "baseline_ref": { "type": ["string", "null"] },
    "candidate_ref": { "type": ["string", "null"] },
    "semantic_comparison": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "semantic_equality_result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "hash_comparison": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "schema_comparison": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "candidate_decision_parity": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "opportunity_decision_parity": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "pm_decision_parity": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "capital_allocation_parity": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "planning_parity": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "pending_parity": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "submit_guard_parity": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "consumer_compatibility_result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_APPLICABLE", null] },
    "point_in_time_result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT", "NOT_APPLICABLE", null] },
    "planning_unchanged": { "type": ["boolean", "null"] },
    "submit_unchanged": { "type": ["boolean", "null"] },
    "current_unchanged": { "type": ["boolean", "null"] },
    "ledger_unchanged": { "type": ["boolean", "null"] },
    "pending_unchanged": { "type": ["boolean", "null"] },
    "runtime_state_unchanged": { "type": ["boolean", "null"] },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "HALT"] },
    "evidence_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64}|[0-9a-f]{64})$" },
    "failures": { "type": "array", "items": { "type": "string" } },
    "timestamp_only_differences": { "type": "array", "items": { "type": "string" } },
    "reviewer": { "type": ["string", "null"] }
  }
}
